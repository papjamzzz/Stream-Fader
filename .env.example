# Required
TMDB_API_KEY=your_tmdb_key_here          # themoviedb.org/settings/api
MDBLIST_API_KEY=your_mdblist_key         # mdblist.com/preferences/ (Standard plan recommended)

# Recommended
TRAKT_CLIENT_ID=your_trakt_client_id     # trakt.tv/oauth/applications
TRAKT_CLIENT_SECRET=your_trakt_secret

# Optional features
ANTHROPIC_API_KEY=your_anthropic_key     # Claude Top Pick feature
BREVO_API_KEY=your_brevo_api_key         # Email subscriber storage

# Affiliate tags — add once approved, links go live automatically (no redeploy needed)
AFFILIATE_AMAZON=                        # Amazon Associates tag (e.g. streamfader-20)
AFFILIATE_APPLE=                         # Apple Performance Partners token
AFFILIATE_HULU=                          # Impact Radius — Hulu
AFFILIATE_DISNEY=                        # Impact Radius — Disney+
AFFILIATE_PARAMOUNT=                     # Impact Radius — Paramount+
AFFILIATE_MAX=                           # Impact Radius — Max
AFFILIATE_PEACOCK=                       # CJ Affiliate — Peacock
